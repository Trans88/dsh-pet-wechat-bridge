{
  "name": "little-pet",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "description": "Independent AI companion with a local web app, persistent memory and Weixin bridge",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node app.mjs start",
    "check": "node app.mjs check",
    "login": "node bridge.mjs login",
    "test": "node --test test/*.test.mjs",
    "wechat": "node bridge.mjs start",
    "legacy:wechat": "node bridge.mjs start --legacy"
  },
  "dependencies": {
    "jpeg-js": "0.4.4",
    "pngjs": "5.0.0",
    "qrcode": "1.5.4",
    "silk-wasm": "3.7.1"
  },
  "devDependencies": {
    "jsdom": "27.2.0"
  }
}
