{
  "name": "little-pet",
  "version": "0.15.0",
  "private": true,
  "type": "module",
  "description": "Independent AI companion with pet interactions, persistent memory, Weixin and official QQ channels",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node app.mjs start",
    "check": "node app.mjs check",
    "browser:install": "playwright install chromium",
    "login": "node bridge.mjs login",
    "test": "node --test test/*.test.mjs",
    "wechat": "node bridge.mjs start",
    "legacy:wechat": "node bridge.mjs start --legacy",
    "desktop": "node desktop/launch.mjs",
    "desktop:setup": "node desktop/setup.mjs",
    "desktop:build": "node desktop/build.mjs"
  },
  "dependencies": {
    "@tencent-connect/qqbot-nodejs": "1.0.5",
    "jpeg-js": "0.4.4",
    "playwright": "1.65.0",
    "pngjs": "5.0.0",
    "qrcode": "1.5.4",
    "silk-wasm": "3.7.1",
    "undici": "7.30.2"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "45.3.1",
    "esbuild": "0.28.2",
    "jsdom": "27.2.0"
  },
  "main": "desktop/main.cjs"
}
